{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Stylist Response Schema (backend copy)",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "suggested_outfits"],
  "properties": {
    "message": { "type": "string" },
    "suggested_outfits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "item_ids"],
        "properties": {
          "id": { "type": "string" },
          "item_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "image_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "reason": { "type": "string", "maxLength": 1000 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
