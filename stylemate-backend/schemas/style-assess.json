{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Style Assessment Schema (backend copy)",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "score", "recommendations"],
  "properties": {
    "message": { "type": "string" },
    "score": { "type": "number", "minimum": 0, "maximum": 10 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "outfit_analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fit": { "type": "string" },
        "style_coherence": { "type": "string" },
        "color_harmony": { "type": "string" },
        "occasion_appropriateness": { "type": "string" },
        "overall_impression": { "type": "string" }
      }
    },
    "photo_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "posture": { "type": "string" },
        "grooming": { "type": "string" },
        "confidence_level": { "type": "string" },
        "photography_quality": { "type": "string" }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "reason": { "type": "string" },
          "category": { "type": "string", "enum": ["color", "fit", "style", "accessory", "general"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "related_items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id","name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "image_url": { "type": "string", "format": "uri" }
              }
            }
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "payload": { "type": "object" }
            }
          }
        }
      }
    },
    "suggested_outfits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","item_ids"],
        "properties": {
          "id": { "type": "string" },
          "item_ids": { "type": "array", "items": { "type": "string" } },
          "image_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "reason": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "items_detail": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "category": { "type": "string" },
                "color": { "type": "string" },
                "brand": { "type": "string" },
                "image_url": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    },
    "styling_tips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tip"],
        "properties": {
          "tip": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "closet_optimization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strengths": { "type": "array", "items": { "type": "string" } },
        "gaps": { "type": "array", "items": { "type": "string" } },
        "color_palette": { "type": "array", "items": { "type": "string" } },
        "recommended_additions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "followup_questions": { "type": "array", "items": { "type": "string" } }
  }
}
