{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Optimized Style Assessment Schema",
  "type": "object",
  "required": ["message", "score", "recommendations"],
  "properties": {
    "message": { "type": "string" },
    "score": { "type": "number", "minimum": 0, "maximum": 10 },
    "outfit_analysis": {
      "type": "object",
      "properties": {
        "fit": { "type": "string" },
        "harmony": { "type": "string" },
        "occasion": { "type": "string" }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "reason"],
        "properties": {
          "text": { "type": "string" },
          "reason": { "type": "string" },
          "category": { "type": "string" },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "suggested_outfits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "item_ids", "reason"],
        "properties": {
          "id": { "type": "string" },
          "item_ids": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    },
    "followup_questions": { "type": "array", "items": { "type": "string" } }
  }
}
