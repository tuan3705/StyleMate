{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Home Suggestion Schema",
  "type": "object",
  "required": ["headline", "message", "suggested_outfits"],
  "properties": {
    "headline": { "type": "string", "description": "Short catchy title for the day's suggestion" },
    "message": { "type": "string", "description": "Brief commentary on the day's style" },
    "suggested_outfits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "item_ids", "reason"],
        "properties": {
          "id": { "type": "string" },
          "item_ids": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" },
          "confidence": { "type": "number" }
        }
      }
    }
  }
}
