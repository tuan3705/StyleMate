{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Virtual Try-on Job Result Schema (backend copy)",
  "type": "object",
  "additionalProperties": false,
  "required": ["images", "thumbs", "meta", "expiresAt"],
  "properties": {
    "images": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
    "thumbs": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "steps"],
      "properties": {
        "provider": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
