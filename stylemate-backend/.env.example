# ═══════════════════════════════════════════════════════════
# 🌍 Stylemate Backend — Biến môi trường
# ═══════════════════════════════════════════════════════════

# Cổng chạy server (mặc định 3000)
PORT=3000

# URI kết nối MongoDB
MONGODB_URI=

# API Key cho WeatherAPI.com (proxy backend)
WEATHER_API_KEY=
REMOVE_BG_API_KEY=
LYKDAT_TAGGING_API_KEY=

# JWT config cho Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Remove.bg API key
REMOVE_BG_API_KEY=your_remove_bg_api_key
