#Them nhung dong sau vao cuoi local.properties
# ═══════════════════════════════════════════════════════════════
# 🚀 STYLEMATE BACKEND URL CONFIGURATION
# ═══════════════════════════════════════════════════════════════
#
#   Bước 1: Chạy backend Node.js trước (npm run dev)
#   Bước 2: Mở Terminal mới, chạy lệnh Proxy dưới đây:
#
#   👉 Dùng Localtunnel (Miễn phí, không cần cài đặt):
#      npx localtunnel --port 3000 --subdomain stylemate
#
#    => Copy url roi insert vào STYLEMATE_BASE_URL bên dưới
# ═══════════════════════════════════════════════════════════════

# Khi dùng Emulator, bạn có thể comment dòng dưới để Gradle tự dùng: http://10.0.2.2:3000/
STYLEMATE_BASE_URL=https://stylemate.loca.lt