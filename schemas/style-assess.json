{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Style Assessment Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "score", "recommendations"],
  "properties": {
    "message": { "type": "string" },
    "score": { "type": "number", "minimum": 0, "maximum": 10 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "category_tags": { "type": "array", "items": { "type": "string" } },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "reason": { "type": "string" },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "related_items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id","name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "image_url": { "type": "string", "format": "uri" }
              }
            }
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "payload": { "type": "object" }
            }
          }
        }
      }
    },
    "fit_advice": { "type": "array", "items": { "type": "string" } },
    "exemplar_outfits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","item_ids"],
        "properties": {
          "id": { "type": "string" },
          "item_ids": { "type": "array", "items": { "type": "string" } },
          "image_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "reason": { "type": "string" }
        }
      }
    },
    "closet_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_items": { "type": "integer", "minimum": 0 },
        "top_categories": { "type": "array", "items": { "type": "string" } },
        "sample_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id","name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "category": { "type": "string" },
              "image_url": { "type": "string", "format": "uri" }
            }
          }
        },
        "color_profile": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      }
    },
    "followups": { "type": "array", "items": { "type": "string" } },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "provider": { "type": "string" }
      }
    }
  }
}
