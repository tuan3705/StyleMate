{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Style Chat Response Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["message"],
  "properties": {
    "message": { "type": "string" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "payload"],
        "properties": {
          "type": { "type": "string" },
          "payload": { "type": "object" }
        }
      }
    }
  }
}
